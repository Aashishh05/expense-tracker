{
  "name": "expense-tracker-server",
  "version": "1.0.0",
  "description": "Express + MongoDB REST API for the Expense Tracker app",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
